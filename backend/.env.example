# HuggingFace token — required for gated models like Gemma 4
# Get yours at https://huggingface.co/settings/tokens
# Accept the Gemma terms at https://huggingface.co/google/gemma-4-E4B-it first
HF_TOKEN=hf_your_token_here

# Override config.yaml values via environment (optional)
# MODEL_REPO_ID=google/gemma-4-4b-it
# MODEL_QUANTIZATION=4bit
# SERVER_PORT=8000
# LOG_LEVEL=INFO

# Optional: enables Anthropic / OpenAI models in the UI
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: TypeSafe Jev (System One) for fast decisions � research routing,
# guardrails, memory gating. Get a key at https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=apikey_...

# Optional: contact URL/email sent in the research agent's User-Agent
# (sites like Wikipedia require one). Defaults to this project's GitHub URL.
# RESEARCH_CONTACT=https://github.com/you/your-repo
